# Copia este archivo a .env y ajusta los valores si hace falta

# Conexión a PostgreSQL (usada por Next.js y por docker-compose)
# Nota: el 5433 evita chocar con otras instancias de Postgres en local
DATABASE_URL=postgresql://extracto:extracto@localhost:5433/extracto

# Variables de docker-compose
POSTGRES_USER=extracto
POSTGRES_PASSWORD=extracto
POSTGRES_DB=extracto
POSTGRES_PORT=5433

# Almacenamiento de archivos subidos
UPLOAD_DIR=./uploads

# Límite de tamaño por archivo (MB)
MAX_UPLOAD_MB=25

# Extracción con LLM de visión (OpenRouter + DeepSeek con visión/OCR)
# Clave en https://openrouter.ai/keys
OPENROUTER_API_KEY=
EXTRACT_MODEL=deepseek/deepseek-v4.1-flash
EXTRACT_MAX_PDF_PAGES=3
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embeddings para pgvector (mismo endpoint de OpenRouter)
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIMS=1536
